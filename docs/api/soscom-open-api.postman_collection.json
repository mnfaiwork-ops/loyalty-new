{
	"info": {
		"name": "Reglow — Soscom Open API",
		"description": "Set variable `base_url` dan `api_key` (API key client dari WMS: Lainnya → Client → Aksi → API Key). Dikirim sebagai header `X-Api-Key`. Data otomatis dibatasi ke client pemilik key.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080", "type": "string" },
		{ "key": "api_key", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "Get Order Detail by Phone + AWB",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "X-Api-Key", "value": "{{api_key}}" }
				],
				"url": {
					"raw": "{{base_url}}/v1/open/social-commerce/orders/detail?phone=083899502475&awb=C1MACRQU",
					"host": ["{{base_url}}"],
					"path": ["v1", "open", "social-commerce", "orders", "detail"],
					"query": [
						{ "key": "phone", "value": "083899502475", "description": "Wajib. 08xx / 628xx / +628xx" },
						{ "key": "awb", "value": "C1MACRQU", "description": "Wajib. Nomor resi" }
					]
				},
				"description": "Detail order soscom yang cocok dengan phone + AWB. Tidak cocok → 404."
			}
		},
		{
			"name": "Get Orders by Date Range",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "X-Api-Key", "value": "{{api_key}}" }
				],
				"url": {
					"raw": "{{base_url}}/v1/open/social-commerce/orders/export?start_date=2026-10-01&end_date=2026-10-05&date_type=created_at",
					"host": ["{{base_url}}"],
					"path": ["v1", "open", "social-commerce", "orders", "export"],
					"query": [
						{ "key": "start_date", "value": "2026-10-01", "description": "Wajib. YYYY-MM-DD" },
						{ "key": "end_date", "value": "2026-10-05", "description": "Wajib. YYYY-MM-DD, maks 31 hari" },
						{ "key": "date_type", "value": "created_at", "description": "created_at (default) / order_at / leads_at" },
						{ "key": "status", "value": "", "disabled": true, "description": "Pisah koma" },
						{ "key": "status_payment", "value": "", "disabled": true, "description": "Pisah koma" },
						{ "key": "ads_platform_id", "value": "", "disabled": true },
						{ "key": "customer_service_id", "value": "", "disabled": true },
						{ "key": "warehouse_id", "value": "", "disabled": true },
						{ "key": "customer", "value": "", "disabled": true, "description": "Nama / no. HP (like)" },
						{ "key": "search", "value": "", "disabled": true, "description": "Reference no / AWB (exact)" }
					]
				},
				"description": "Data order soscom sesuai kolom export xlsx. Tanpa pagination."
			}
		}
	]
}
